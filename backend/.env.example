# ===== ShopEasy Environment Variables (copy to .env and fill in) =====

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/shopeasy

# JWT signing secret. MUST be a strong random string (>= 48 chars).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never commit the real value to the repo; .env is git-ignored.
JWT_SECRET=replace_with_a_64_char_random_hex_string_from_the_command_above

# Port the API listens on
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# Example: CLIENT_ORIGINS=https://myapp.vercel.app,https://admin.myapp.com
CLIENT_ORIGINS=http://localhost:5000

# Set to 'true' only when the app runs behind a trusted reverse proxy
# (Render/Vercel/nginx) so rate limiting sees the real client IP.
# TRUST_PROXY=true
